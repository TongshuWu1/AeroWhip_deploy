{
  "algorithm": "ppo",
  "task": "configs/tasks/whip_stage4_cone25_v2.json",
  "model": "configs/simulation.json",
  "scene": "configs/scenes/default.toml",
  "device": "cuda",
  "seed": 1,
  "parallel_environments": 128,
  "evaluation_environments": 64,
  "training_episodes": 10240,
